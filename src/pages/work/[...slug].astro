---
import { type CollectionEntry, getCollection } from 'astro:content';
import CitationMetric from '../../components/CitationMetric.astro';
import PullQuote from '../../components/PullQuote.astro';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
	const items = await getCollection('work');
	return items.map((item) => ({
		params: { slug: item.id },
		props: item,
	}));
}
type Props = CollectionEntry<'work'>;

const { data } = Astro.props;
const {
	headline,
	dek,
	client,
	whereThingsStood,
	theCall,
	whatGotBuilt,
	metrics,
	whatIdDoDifferently,
	scope,
	quotes,
} = data;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: headline,
	about: dek,
	creator: { '@type': 'Person', name: 'Aaron Amerling' },
};
---

<PageLayout title={`${headline} · Aaron Amerling`} description={dek} schema={schema}>
	<div class="wrap section-lg prose">
		<p class="eyebrow client reveal">{client}</p>
		<h1 class="reveal">{headline}</h1>
		<p class="dek reveal">{dek}</p>

		<h2 class="reveal">Where things stood</h2>
		<p class="reveal">{whereThingsStood}</p>

		<h2 class="reveal">The call</h2>
		<p class="reveal" set:html={theCall} />

		<h2 class="reveal">What got built</h2>
		<ol class="built reveal">
			{whatGotBuilt.map((step) => <li>{step}</li>)}
		</ol>

		{metrics.length > 0 && (
			<>
				<h2 class="reveal">Results</h2>
				<div class="metrics">
					{metrics.map((m) => <CitationMetric value={m.value} label={m.label} citation={m.citation} />)}
				</div>
			</>
		)}

		{whatIdDoDifferently && <h2 class="reveal">What I would do differently</h2>}
		{whatIdDoDifferently && <p class="reveal">{whatIdDoDifferently}</p>}
		{!whatIdDoDifferently && (
			<Fragment set:html={'<!-- NEEDS: one honest line on what I would do differently -->'} />
		)}

		<h2 class="reveal">Scope</h2>
		<p class="reveal">{scope}</p>

		{quotes && quotes.map((q) => (
			<PullQuote
				quote={q.text}
				name={q.name}
				roleAtTime={q.roleAtTime}
				current={q.current}
				full={q.full}
				linkedin={q.linkedin}
			/>
		))}

		<p class="reveal"><a href={`${import.meta.env.BASE_URL}work/`}>&larr; Back to work</a></p>
	</div>
</PageLayout>

<style>
	.dek {
		font-size: 1.15rem;
		color: var(--muted);
	}
	.built {
		padding-left: 1.3em;
	}
	.built li {
		margin-bottom: 0.6em;
	}
	.metrics {
		margin-bottom: 1em;
	}
	p.needs {
		font-family: var(--font-mono), monospace;
		font-size: 13px;
		color: var(--muted);
		border: 1px dashed var(--rule);
		padding: 0.75em 1em;
	}
</style>
