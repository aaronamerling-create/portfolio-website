---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const items = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
	title="Work · Aaron Amerling"
	description="Nine case studies in growth, applied AI, org design and product marketing."
>
	<div class="wrap section-lg">
		<p class="eyebrow">Work</p>
		<h1>Case studies</h1>
		<div class="case-list">
			{
				items.map((item) => (
					<a class="case-row reveal" href={`${import.meta.env.BASE_URL}work/${item.id}/`}>
						<p class="eyebrow client">{item.data.client}</p>
						<h3>{item.data.headline}</h3>
						<p class="dek">{item.data.dek}</p>
					</a>
				))
			}
		</div>
	</div>
</PageLayout>
