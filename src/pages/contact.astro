---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
	title="Contact Aaron Amerling"
	description="Get in touch about a role, a consulting engagement, or anything else."
>
	<div class="wrap section-lg prose">
		<h1 class="reveal">Get in touch.</h1>
		<p class="reveal">
			The fastest route is email: <a href="mailto:aaronamerling@gmail.com">aaronamerling@gmail.com</a>.
			The form works too, and the first question helps me reply usefully.
		</p>

		<form id="contact-form" class="reveal">
			<div class="form-field">
				<label for="reason">What brings you here?</label>
				<select id="reason" name="reason" required>
					<option value="">Select one</option>
					<option value="Hiring for a role">Hiring for a role</option>
					<option value="Exploring consulting or advisory">Exploring consulting or advisory</option>
					<option value="Something else">Something else</option>
				</select>
			</div>
			<div class="form-field">
				<label for="name">Name</label>
				<input id="name" name="name" type="text" required />
			</div>
			<div class="form-field">
				<label for="email">Email</label>
				<input id="email" name="email" type="email" required />
			</div>
			<div class="form-field">
				<label for="company">Company</label>
				<input id="company" name="company" type="text" />
			</div>
			<div class="form-field">
				<label for="message">What's on your mind?</label>
				<textarea id="message" name="message"></textarea>
			</div>

			<input type="text" name="_honey" class="honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
			<input type="hidden" name="_template" value="table" />
			<input type="hidden" name="_captcha" value="false" />

			<button type="submit" class="btn btn-accent">Send message</button>
			<p id="form-status" class="mono status" role="status"></p>
		</form>
	</div>

	<script>
		const ENDPOINT = 'https://formsubmit.co/ajax/aaronamerling@gmail.com';

		const params = new URLSearchParams(window.location.search);
		const reasonParam = params.get('reason');
		if (reasonParam === 'consulting') {
			const select = document.getElementById('reason') as HTMLSelectElement | null;
			if (select) select.value = 'Exploring consulting or advisory';
		}

		const form = document.getElementById('contact-form') as HTMLFormElement | null;
		const status = document.getElementById('form-status');
		const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

		function mailtoFallback(data: FormData) {
			const subject = `Portfolio contact: ${data.get('reason')}`;
			const body = [
				`Name: ${data.get('name')}`,
				`Email: ${data.get('email')}`,
				`Company: ${data.get('company') || 'n/a'}`,
				'',
				String(data.get('message') || ''),
			].join('\n');
			window.location.href = `mailto:aaronamerling@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
		}

		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const data = new FormData(form);
			data.set('_subject', `Portfolio contact: ${data.get('reason')}`);

			if (submitBtn) submitBtn.disabled = true;
			if (status) status.textContent = 'Sending...';

			try {
				const res = await fetch(ENDPOINT, {
					method: 'POST',
					headers: { Accept: 'application/json' },
					body: data,
				});
				if (!res.ok) throw new Error(`Request failed: ${res.status}`);
				if (status) status.textContent = 'Message sent. I reply within a day, usually sooner.';
				form.reset();
			} catch {
				if (status) status.textContent = "That didn't send automatically, opening your email client instead.";
				mailtoFallback(data);
			} finally {
				if (submitBtn) submitBtn.disabled = false;
			}
		});
	</script>
</PageLayout>

<style>
	.status {
		margin-top: 1em;
	}
	.honey {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
</style>
