---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
	title="Resume · Aaron Amerling"
	description="Full career history and downloadable resume for Aaron Amerling, marketing and product leader based in San Diego."
>
	<div class="wrap section-lg prose">
		<p class="eyebrow reveal">Resume</p>
		<h1 class="reveal">Aaron Amerling</h1>
		<p class="reveal">
			Chief Marketing Officer and product leader based in San Diego. Full career history, patents
			and recognition below, or download the PDF.
		</p>
		<a class="btn btn-accent reveal" href={`${import.meta.env.BASE_URL}aaron-amerling-resume.pdf`} download>
			Download resume (PDF)
		</a>
	</div>
	<div class="wrap section-lg">
		<object
			data={`${import.meta.env.BASE_URL}aaron-amerling-resume.pdf`}
			type="application/pdf"
			class="resume-embed reveal"
		>
			<p>
				<a href={`${import.meta.env.BASE_URL}aaron-amerling-resume.pdf`}>Download the resume PDF</a>
			</p>
		</object>
	</div>
</PageLayout>

<style>
	.resume-embed {
		width: 100%;
		height: 80vh;
		border: 1px solid var(--rule);
	}
</style>
