---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<PageLayout
	title="Blog · Aaron Amerling"
	description="Notes on answer engine optimization, applied AI inside marketing organizations, and running 60-person departments."
>
	<div class="wrap section-lg">
		<p class="eyebrow">Blog</p>
		<h1>Notes</h1>
		<div class="case-list">
			{
				posts.map((post) => (
					<a class="case-row reveal" href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>
						<p class="eyebrow client">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
						<h3>{post.data.title}</h3>
						<p class="dek">{post.data.description}</p>
					</a>
				))
			}
		</div>
	</div>
</PageLayout>
