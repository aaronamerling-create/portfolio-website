---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { title, description, pubDate } = post.data;
const { Content } = await render(post);

const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	author: { '@type': 'Person', name: 'Aaron Amerling' },
};
---

<PageLayout title={`${title} · Aaron Amerling`} description={description} schema={schema}>
	<div class="wrap section-lg prose">
		<p class="eyebrow reveal">
			{pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
		</p>
		<h1 class="reveal">{title}</h1>
		<div class="reveal">
			<Content />
		</div>
		<p class="reveal"><a href={`${import.meta.env.BASE_URL}blog/`}>&larr; Back to blog</a></p>
	</div>
</PageLayout>
