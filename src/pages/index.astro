---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
			}
			.eyebrow {
				margin: 0;
				color: rgb(var(--gray));
				text-transform: uppercase;
				letter-spacing: 0.04em;
				font-size: 0.9rem;
			}
			.lede {
				font-size: 1.25rem;
				color: rgb(var(--gray-dark));
			}
			.stats {
				display: flex;
				flex-wrap: wrap;
				gap: 2em;
				margin: 2em 0;
				padding: 1.5em 0;
				border-top: 1px solid rgb(var(--gray-light));
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.stats div {
				min-width: 140px;
			}
			.stats strong {
				display: block;
				font-size: 1.8rem;
				color: rgb(var(--black));
			}
			.stats span {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.cta {
				display: flex;
				gap: 1em;
				flex-wrap: wrap;
			}
			.cta a {
				display: inline-block;
				padding: 0.6em 1.2em;
				border-radius: 8px;
				text-decoration: none;
				font-weight: bold;
			}
			.cta a.primary {
				background: rgb(var(--accent));
				color: white;
			}
			.cta a.secondary {
				border: 1px solid rgb(var(--gray-light));
				color: rgb(var(--black));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">Aaron Amerling</p>
			<h1>Growth & Demand Generation Leader</h1>
			<p class="lede">
				Growth marketing leader who owns the number, not just the channel. I build measurable,
				trackable pipeline across B2B and B2B2C audiences, run the full digital and
				revenue-operations stack, and do it AI-natively — deploying Generative Engine Optimization
				and Answer Engine Optimization as live growth channels ahead of the category.
			</p>
			<div class="stats">
				<div>
					<strong>$40M+</strong>
					<span>Annual paid media budget managed</span>
				</div>
				<div>
					<strong>400%</strong>
					<span>Sales increase, CPA cut ~2/3 in one year</span>
				</div>
				<div>
					<strong>60</strong>
					<span>-person marketing org led</span>
				</div>
				<div>
					<strong>5</strong>
					<span>U.S. patents, co-inventor</span>
				</div>
			</div>
			<div class="cta">
				<a class="primary" href={`${import.meta.env.BASE_URL}work/`}>See the work</a>
				<a class="secondary" href={`${import.meta.env.BASE_URL}about/`}>About me</a>
				<a class="secondary" href="mailto:aaronamerling@gmail.com">Get in touch</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
