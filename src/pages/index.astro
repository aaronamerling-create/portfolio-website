---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import headshot from '../assets/photos/aaron-amerling.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { BRANDS, SITE_DESCRIPTION, SITE_TITLE, TESTIMONIALS } from '../consts';

const featuredWork = (await getCollection('work'))
	.sort((a, b) => a.data.order - b.data.order)
	.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero-inner {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 5em 1em 4em 1em;
				position: relative;
				display: flex;
				align-items: center;
				gap: 3em;
			}
			.hero-copy {
				flex: 1.3;
			}
			.hero-copy h1 {
				font-size: 2.8em;
				margin: 0.2em 0 0.5em 0;
			}
			.hero-copy .lede {
				font-size: 1.15rem;
				max-width: 46ch;
			}
			.hero-photo {
				flex: 1;
				display: flex;
				justify-content: center;
			}
			.hero-photo :global(img) {
				width: 260px;
				height: 260px;
				object-fit: cover;
				border-color: var(--dark-1) !important;
			}
			.cta {
				display: flex;
				gap: 0.8em;
				flex-wrap: wrap;
				margin-top: 1.5em;
			}
			.stat-grid {
				margin-top: 3em;
			}
			@media (max-width: 820px) {
				.hero-inner {
					flex-direction: column-reverse;
					text-align: center;
					padding-top: 3em;
				}
				.hero-copy .lede {
					max-width: none;
				}
				.cta {
					justify-content: center;
				}
			}

			.brand-wall {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1em;
			}
			.brand-wall .brand {
				display: flex;
				align-items: center;
				justify-content: center;
				height: 90px;
				padding: 1em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				background: #fff;
			}
			.brand-wall .brand img {
				max-width: 100%;
				max-height: 40px;
				border-radius: 0;
			}
			.brand-wall .brand span {
				color: rgb(var(--gray));
				font-weight: 700;
				text-align: center;
				font-size: 0.9rem;
				letter-spacing: 0.01em;
			}
			@media (max-width: 720px) {
				.brand-wall {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			.work-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5em;
			}
			.work-grid .client {
				margin: 0 0 0.4em 0;
				color: var(--accent);
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				font-weight: 700;
			}
			.work-grid h3 {
				font-size: 1.2rem;
				margin-bottom: 0.5em;
			}
			.work-grid p {
				color: rgb(var(--gray));
				font-size: 0.95rem;
				margin-bottom: 0;
			}
			@media (max-width: 820px) {
				.work-grid {
					grid-template-columns: 1fr;
				}
			}

			.section-head {
				text-align: center;
				max-width: 620px;
				margin: 0 auto 2.5em auto;
			}

			.final-cta {
				text-align: center;
			}
			.final-cta .cta {
				justify-content: center;
			}
		</style>
	</head>
	<body>
		<Header />

		<section class="hero-dark">
			<div class="hero-inner">
				<div class="hero-copy">
					<p class="eyebrow">Aaron Amerling</p>
					<h1>Growth marketing that owns <span class="gradient-text">the number</span>, not just the channel.</h1>
					<p class="lede">
						I build measurable, trackable pipeline across B2B and B2B2C audiences, run the full
						digital and revenue-operations stack, and do it AI-natively — deploying Generative
						Engine Optimization and Answer Engine Optimization as live growth channels ahead of
						the category.
					</p>
					<div class="cta">
						<a class="btn btn-primary" href={`${import.meta.env.BASE_URL}work/`}>See the work</a>
						<a class="btn btn-ghost" href={`${import.meta.env.BASE_URL}about/`}>About me</a>
						<a class="btn btn-ghost" href="mailto:aaronamerling@gmail.com">Get in touch</a>
					</div>
				</div>
				<div class="hero-photo">
					<div class="avatar-ring">
						<Image src={headshot} alt="Aaron Amerling" width={260} height={260} />
					</div>
				</div>
			</div>
			<div class="wide stat-grid">
				<div class="stat">
					<strong>$40M+</strong>
					<span>Annual paid media budget managed</span>
				</div>
				<div class="stat">
					<strong>400%</strong>
					<span>Sales increase, CPA cut ~2/3 in one year</span>
				</div>
				<div class="stat">
					<strong>60</strong>
					<span>-person marketing org led</span>
				</div>
				<div class="stat">
					<strong>5</strong>
					<span>U.S. patents, co-inventor</span>
				</div>
			</div>
		</section>

		<section>
			<div class="wide">
				<div class="section-head">
					<p class="eyebrow">Social proof</p>
					<h2>Brands I've worked with</h2>
				</div>
				<div class="brand-wall">
					{
						BRANDS.map((brand) => (
							<div class="brand">
								{brand.logo ? (
									<img
										src={`${import.meta.env.BASE_URL}logos/${brand.logo}`}
										alt={brand.name}
										loading="lazy"
									/>
								) : (
									<span>{brand.name}</span>
								)}
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section>
			<div class="wide">
				<div class="section-head">
					<p class="eyebrow">Selected work</p>
					<h2>Case studies</h2>
				</div>
				<div class="work-grid">
					{
						featuredWork.map((item) => (
							<a class="card" href={`${import.meta.env.BASE_URL}work/${item.id}/`}>
								<p class="client">{item.data.client}</p>
								<h3>{item.data.title}</h3>
								<p>{item.data.summary}</p>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section>
			<div class="wide">
				<div class="section-head">
					<p class="eyebrow">What people say</p>
					<h2>Recommendations</h2>
				</div>
				<div class="quote-grid">
					{
						TESTIMONIALS.map((t) => (
							<div class="quote-card">
								<p class="quote">{t.quote}</p>
								<p class="attribution">
									{t.name}
									<span>{t.title}</span>
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="final-cta">
			<div class="wide">
				<h2>Let's build the next number together.</h2>
				<div class="cta">
					<a class="btn btn-primary" href="mailto:aaronamerling@gmail.com">Email me</a>
					<a class="btn btn-outline" href="https://www.linkedin.com/in/aaronamerling/" target="_blank"
						>Connect on LinkedIn</a
					>
				</div>
			</div>
		</section>

		<Footer />
	</body>
</html>
