---
import { Image } from 'astro:assets';
import headshot from '../assets/photos/aaron-amerling.jpg';
import CitationMetric from '../components/CitationMetric.astro';
import PullQuote from '../components/PullQuote.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { CLAIM_QUOTES, FEATURED_QUOTE, LOGO_ROWS, SITE_DESCRIPTION, TESTIMONIALS } from '../consts';
---

<PageLayout title="Aaron Amerling · Chief Marketing Officer and Product Leader" description={SITE_DESCRIPTION}>
	<div class="wrap section-lg hero-grid">
		<div class="hero-copy">
			<p class="eyebrow reveal">Aaron Amerling &middot; San Diego</p>
			<h1 class="reveal">I find the shift <span class="gradient-text">before it's obvious</span>, then build for it.</h1>
			<p class="lede reveal">
				Chief Marketing Officer, product leader and co-inventor on five U.S. patents. I have built
				60-person marketing organizations, managed £40M budgets, and had answer engine optimization
				running as a live growth channel before the category had a name.
			</p>
			<div class="link-row reveal">
				<a class="btn btn-accent" href={`${import.meta.env.BASE_URL}work/`}>Case studies</a>
				<a class="btn" href={`${import.meta.env.BASE_URL}aaron-amerling-resume.pdf`}>Resume</a>
				<a class="btn" href={`${import.meta.env.BASE_URL}contact/`}>Contact me</a>
			</div>
		</div>
		<div class="hero-photo" data-parallax="0.06">
			<Image class="reveal" src={headshot} alt="Aaron Amerling" width={340} height={340} />
		</div>
	</div>

	<div class="wrap">
		<PullQuote quote={FEATURED_QUOTE.quote} name={FEATURED_QUOTE.name} roleAtTime={FEATURED_QUOTE.title} />
	</div>

	<div class="wrap">
		<section class="claim">
			<p class="eyebrow reveal">01 &middot; Growth</p>
			<h2 class="reveal">Numbers, with the work behind them attached.</h2>
			<p class="reveal">Paid, owned, earned and product marketing across consumer, health, fintech, telecom and gaming.</p>
			<div class="metrics">
				<CitationMetric value="£40M+" label="annual paid media budget managed (roughly $50M)" citation="GAIN Credit, 2016 to 2017. Sr. Manager, Digital Product and Marketing." />
				<CitationMetric value="400%" label="sales increase, CPA cut by roughly two thirds in one year" citation="GreatCall (now Best Buy Health), 2013 to 2014." />
				<CitationMetric value="25,000 to 1.5M" label="mobile users, two #1 Medical-category apps" citation="GreatCall, 2012 to 2016. App Store and Google Play." />
				<CitationMetric value="~10/yr to 100+/mo" label="inbound MQLs, outranking Nielsen" citation="TrendSource, strategic marketing advisor." />
			</div>
			{CLAIM_QUOTES.growth.map((q) => (
				<PullQuote quote={q.quote} name={q.name} roleAtTime={q.title} current={q.current} />
			))}
		</section>

		<section class="claim">
			<p class="eyebrow reveal">02 &middot; Applied AI</p>
			<h2 class="reveal">AEO and GEO as live channels, not a slide in a deck.</h2>
			<p class="reveal">
				I stood up answer engine optimization as a growth channel before most agencies had a name
				for it, rolled generative AI across a marketing organization of sixty people, and launched
				AI consumer-facing products. I design, prototype and ship with the tooling myself.
			</p>
			<div class="metrics">
				<CitationMetric value="AEO / GEO" label="stood up as a live growth channel before most agencies had a name for it" citation="Etna Interactive, 2024 to 2026. Chief Marketing Officer." />
				<CitationMetric value="Techstars" label="mentor to early-stage AI founders" citation="Techstars network, ongoing." />
				<CitationMetric value="Tony Robbins" label="landed as flagship customer for an AI digital twin venture" citation="Steno.ai, strategic advisor." />
			</div>
			<Fragment set:html={'<!-- NEEDS: Steno.ai founder or Etna executive on AEO/gen-AI work -->'} />
		</section>

		<section class="claim">
			<p class="eyebrow reveal">03 &middot; People and organizations</p>
			<h2 class="reveal">I build marketing organizations, not just campaigns.</h2>
			<p class="reveal">
				A department is a strategy document. Where paid sits determines what gets optimized, and
				how specialists are promoted determines who is still there in two years.
			</p>
			<div class="metrics">
				<CitationMetric value="60 people" label="across paid, owned, earned, strategy and client services" citation="Etna Interactive, 2024 to 2026. Chief Marketing Officer." />
				<CitationMetric value="3 continents" label="top-performing sales channel within six months" citation="GAIN Credit. San Diego, London, Chennai." />
				<CitationMetric value="14 agencies" label="and vendors managed simultaneously" citation="GreatCall, 2012 to 2016." />
			</div>
			{CLAIM_QUOTES.org.map((q) => (
				<PullQuote quote={q.quote} name={q.name} roleAtTime={q.title} current={q.current} />
			))}
		</section>

		<section class="claim">
			<p class="eyebrow reveal">04 &middot; Technology and early calls</p>
			<h2 class="reveal">Five patents, and a habit of reading the curve early.</h2>
			<p class="reveal">
				Co-inventor on five U.S. patents for a trust-network architecture, built originally for
				emergency response call centers and written broadly enough to cover authentication,
				identity verification and influence targeting. I called crowdfunding, mobile health, and
				AEO before each had a category name.
			</p>
			<div class="metrics">
				<CitationMetric value="5" label="U.S. patents, co-inventor" citation="Filed 2016 to 2017. Assigned to GreatCall / Best Buy Health." />
				<CitationMetric value="GoFundMe" label="started advising when it was just the two founders and still called Create-A-Fund" citation="Early marketing advisor." />
				<CitationMetric value="GreatCall Labs" label="founded, produced patents and flagship product lines" citation="GreatCall, internal innovation unit." />
			</div>
			{CLAIM_QUOTES.tech.map((q) => (
				<PullQuote quote={q.quote} name={q.name} roleAtTime={q.title} current={q.current} />
			))}
		</section>
	</div>

	<div class="wrap section-lg">
		<p class="eyebrow reveal">Selected clients and collaborators</p>
		{LOGO_ROWS.map((row) => (
			<div class="logo-row reveal">
				<div class="row-label">
					<span>{row.label}</span>
					<hr />
				</div>
				<div class="logo-grid">
					{row.items.map((item) => (
						<div class:list={['logo-item', { large: item.large }]}>
							<div class="mark">
								{item.logo ? (
									<img src={`${import.meta.env.BASE_URL}logos/${item.logo}`} alt={item.name} loading="lazy" />
								) : (
									<span class="text-mark">{item.name}</span>
								)}
							</div>
							<p class="caption">{item.name} &middot; {item.caption}</p>
						</div>
					))}
				</div>
			</div>
		))}
	</div>

	<div class="wrap section-lg">
		<h2 class="reveal">How to work with me</h2>
		<div class="how-grid">
			<div class="reveal">
				<h3>Full-time leadership</h3>
				<p>Will consider opportunities in senior leadership. San Diego or remote. Consumer, health, fintech, telecom, SaaS, entertainment, gaming and AI.</p>
				<a href={`${import.meta.env.BASE_URL}aaron-amerling-resume.pdf`}>&rarr; Download resume</a>
			</div>
			<div class="reveal">
				<h3>Advisory and fractional</h3>
				<p>Brand, go-to-market and applied AI for founders and growth-stage teams. Currently taking a small number of engagements.</p>
				<a href={`${import.meta.env.BASE_URL}consulting/`}>&rarr; How I work</a>
			</div>
		</div>
	</div>

	<div class="wrap section-lg">
		<p class="eyebrow reveal">What people say</p>
		<h2 class="reveal">Recommendations</h2>
		<div class="rec-grid">
			{TESTIMONIALS.map((t) => (
				<div class="rec-card reveal">
					<p class="rec-quote">{t.quote}</p>
					<p class="rec-attribution">
						{t.name} &middot; {t.title}
						{t.current && <span class="now">now: {t.current}</span>}
					</p>
				</div>
			))}
		</div>
		<p class="rec-more reveal">
			<a href="https://www.linkedin.com/in/aaronamerling/details/recommendations/?detailScreenTabIndex=0" target="_blank">
				Read more recommendations &rarr;
			</a>
		</p>
	</div>

	<div class="wrap section-lg cta-block">
		<h2 class="reveal">Let's build the next number together.</h2>
		<p class="reveal">
			If you're looking for a senior leader, let's talk. If you need advisory or fractional support
			around brand, go-to-market or applied AI, reach out.
		</p>
		<div class="link-row reveal">
			<a class="btn btn-accent" href={`${import.meta.env.BASE_URL}contact/`}>Contact me</a>
			<a class="btn" href={`${import.meta.env.BASE_URL}aaron-amerling-resume.pdf`}>Download resume</a>
		</div>
	</div>
</PageLayout>

<style>
	.hero-grid {
		display: flex;
		align-items: center;
		gap: 3.5em;
	}
	.hero-copy {
		flex: 1.4;
	}
	.hero-photo {
		flex: 1;
		display: flex;
		justify-content: center;
	}
	.hero-photo :global(img) {
		width: 100%;
		max-width: 340px;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		border: 1px solid var(--rule);
	}
	@media (max-width: 820px) {
		.hero-grid {
			flex-direction: column-reverse;
		}
		.hero-photo :global(img) {
			max-width: 220px;
		}
	}
	.lede {
		font-size: 1.2rem;
		max-width: 60ch;
		margin-top: 1em;
	}
	.claim {
		padding: 48px 0;
		border-top: 1px solid var(--rule);
	}
	@media (min-width: 900px) {
		.claim {
			padding: 72px 0;
		}
	}
	.claim .metrics {
		margin: 2em 0;
	}
	.how-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3em;
	}
	.how-grid > div:first-child {
		border-right: 1px solid var(--rule);
		padding-right: 3em;
	}
	@media (max-width: 720px) {
		.how-grid {
			grid-template-columns: 1fr;
		}
		.how-grid > div:first-child {
			border-right: none;
			border-bottom: 1px solid var(--rule);
			padding-right: 0;
			padding-bottom: 2em;
		}
	}
	.rec-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2em;
		margin-top: 2em;
	}
	@media (max-width: 720px) {
		.rec-grid {
			grid-template-columns: 1fr;
		}
	}
	.rec-card {
		border: 1px solid var(--rule);
		padding: 1.75em;
	}
	.rec-quote {
		font-size: 17px;
		color: var(--ink);
		margin-bottom: 1em;
	}
	.rec-quote::before {
		content: '\201C';
		color: var(--accent);
		font-family: var(--font-display), sans-serif;
		font-weight: 700;
	}
	.rec-attribution {
		font-family: var(--font-mono), monospace;
		font-size: 12px;
		color: var(--ink);
		margin: 0;
		line-height: 1.6;
	}
	.rec-attribution .now {
		display: block;
		color: var(--muted);
	}
	.rec-more {
		margin-top: 2em;
		font-weight: 700;
	}
	.text-mark {
		font-family: var(--font-display), sans-serif;
		font-weight: 700;
		font-size: 15px;
		color: var(--ink);
	}
	.cta-block {
		border-top: 1px solid var(--rule);
	}
</style>
