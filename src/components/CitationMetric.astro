---
interface Props {
	value: string;
	label: string;
	citation: string;
}
const { value, label, citation } = Astro.props;
---

<div class="metric-row">
	<div>
		<p class="value reveal zoom">{value}</p>
		<p class="label reveal">{label}</p>
	</div>
	<div class="citation reveal">{citation}</div>
</div>
