---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="wrap">
		<a class="brand" href={import.meta.env.BASE_URL}>{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href="/work">Work</HeaderLink>
			<HeaderLink href="/pov">My POV</HeaderLink>
			<HeaderLink href="/consulting">Consulting</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: var(--paper);
		border-bottom: 1px solid var(--rule);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.1em 0;
	}
	.brand {
		font-family: var(--font-display), sans-serif;
		font-weight: 700;
		font-size: 18px;
		color: var(--ink);
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		gap: 1.75em;
		font-family: var(--font-mono), monospace;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 12px;
	}
	.internal-links :global(a) {
		color: var(--ink);
	}
	.internal-links :global(a.active) {
		color: var(--accent);
	}
	@media (max-width: 620px) {
		.internal-links {
			gap: 1em;
			font-size: 11px;
		}
	}
</style>
