---
import { Image } from 'astro:assets';
import headshot from '../assets/photos/aaron-amerling.jpg';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href={import.meta.env.BASE_URL}>
			<Image src={headshot} alt="" width={36} height={36} class="brand-avatar" />
			<h2>{SITE_TITLE}</h2>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/work">Work</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://www.linkedin.com/in/aaronamerling/" target="_blank">
				<span class="sr-only">Aaron Amerling on LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22"
					><path
						fill="currentColor"
						d="M14.82 0H1.18C.53 0 0 .53 0 1.18v13.64C0 15.47.53 16 1.18 16h13.64c.65 0 1.18-.53 1.18-1.18V1.18C16 .53 15.47 0 14.82 0zM4.75 13.5H2.4V6h2.35v7.5zM3.57 4.98a1.36 1.36 0 1 1 0-2.72 1.36 1.36 0 0 1 0 2.72zM13.5 13.5h-2.35V9.85c0-.87-.02-1.99-1.21-1.99-1.22 0-1.4.95-1.4 1.93v3.71H6.19V6h2.26v1.03h.03c.31-.6 1.09-1.23 2.24-1.23 2.4 0 2.84 1.58 2.84 3.63v4.07z"
					></path></svg
				>
			</a>
			<a href="https://github.com/aaronamerling-create" target="_blank">
				<span class="sr-only">Aaron Amerling on GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href="mailto:aaronamerling@gmail.com">
				<span class="sr-only">Email Aaron Amerling</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22"
					><path
						fill="currentColor"
						d="M1.5 3A1.5 1.5 0 0 0 0 4.5v.379l8 4.615 8-4.615V4.5A1.5 1.5 0 0 0 14.5 3h-13ZM16 6.152l-8 4.615-8-4.615V11.5A1.5 1.5 0 0 0 1.5 13h13a1.5 1.5 0 0 0 1.5-1.5V6.152Z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		margin: 0;
		padding: 0 1em;
		background: rgba(255, 255, 255, 0.75);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	nav {
		width: 960px;
		max-width: 100%;
		margin: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6em;
		text-decoration: none;
	}
	.brand :global(.brand-avatar) {
		border-radius: 999px;
		object-fit: cover;
		width: 36px;
		height: 36px;
	}
	h2 {
		margin: 0;
		font-size: 1em;
		color: rgb(var(--black));
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 3px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		color: var(--accent);
	}
	.internal-links {
		display: flex;
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
	}
	.social-links {
		gap: 0.75em;
		color: rgb(var(--gray));
	}
	.social-links a {
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
