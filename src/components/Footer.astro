---
const today = new Date();
---

<footer>
	<div class="wrap">
		<p class="mono">&copy; {today.getFullYear()} Aaron Amerling</p>
		<div class="links mono">
			<a href="https://www.linkedin.com/in/aaronamerling/" target="_blank">LinkedIn</a>
			<a href="https://github.com/aaronamerling-create" target="_blank">GitHub</a>
			<a href="mailto:aaronamerling@gmail.com">Email</a>
		</div>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--rule);
		padding: 2.5em 0;
	}
	.wrap {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1em;
	}
	p.mono {
		color: var(--muted);
		margin: 0;
	}
	.links {
		display: flex;
		gap: 1.5em;
	}
	.links a {
		color: var(--muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 12px;
	}
	.links a:hover {
		color: var(--accent);
	}
</style>
